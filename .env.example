GROQ_API_KEY=
GROQ_API_KEY_FALL_BACK=
# key5_only is the historical strict-primary identifier retained for frozen
# Agent provider compatibility. It now resolves GROQ_API_KEY only.
# pool resolves primary first and optional fallback second, deduplicated.
GROQ_KEY_POLICY=key5_only
QDRANT_MODE=local
QDRANT_LOCAL_PATH=data/processed/qdrant
QDRANT_INDEX_MANIFEST_PATH=data/processed/qdrant_index_manifest.json
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
PDF_ARTIFACTS_DIR=data/generated/pdf
PDF_GENERATION_ENABLED=true
PDF_GENERATION_TIMEOUT_SECONDS=60
PDF_GENERATION_CONCURRENCY=2
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
# Pin the exact Hugging Face commit used to create embedded artifacts.
EMBEDDING_MODEL_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
# Pin the exact reranker commit used by the serving image.
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
# Immutable build output root and the explicit validated generation selected for indexing.
EMBEDDING_GENERATIONS_DIR=data/embedding_generations
EMBEDDING_GENERATION_PATH=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Private server-side workspace capabilities are unavailable unless this is
# explicitly changed to local and a dedicated token of at least 32
# non-whitespace characters is configured. Never expose this token through a
# VITE_* variable or reuse a provider credential.
WORKSPACE_MODE=public
LOCAL_WORKSPACE_TOKEN=
LOCAL_WORKSPACE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOCAL_WORKSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Job execution is a separate opt-in capability in local mode.
ENABLE_WORKSPACE_EXECUTION=false
# Agent workers start only when local execution is enabled. Disabling workers
# leaves admitted Agent jobs queued; Evaluation keeps its existing executor.
WORKSPACE_WORKER_ENABLED=true
WORKSPACE_WORKER_CONCURRENCY=2
WORKSPACE_WORKER_POLL_INTERVAL_MS=500
WORKSPACE_WORKER_SHUTDOWN_GRACE_MS=5000
# Local workspace state is isolated from canonical data/, evaluation and Qdrant
# artifacts. Relative paths must remain under .local/.
WORKSPACE_DB_PATH=.local/workbench/workspace.sqlite3
WORKSPACE_RUNS_DIR=.local/workbench/runs
WORKSPACE_SQLITE_BUSY_TIMEOUT_MS=5000
LLM_RATE_LIMIT_BURST=10/minute
LLM_RATE_LIMIT_DAILY=100/day
DECOMPOSED_RATE_LIMIT=5/minute
CACHE_TEST_RATE_LIMIT=10/minute
SEARCH_RATE_LIMIT=30/minute
ENABLE_CACHE_CLEAR=false
ENABLE_METRICS_ENDPOINT=false
# Comma-separated CIDR ranges of reverse proxies trusted to set
# X-Forwarded-For (ngrok tunnel, Docker gateway, ...). Empty keeps
# rate limits keyed on the socket peer address. Example for the
# ngrok-plus-local-Docker topology:
# TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8,::1/128
TRUSTED_PROXY_CIDRS=
