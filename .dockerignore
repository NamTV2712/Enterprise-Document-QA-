# Keep the build context minimal: corpus data, secrets, frontend, and
# diagnostics artifacts are never part of the image.
.venv/
.git/
.github/
.env
.env.*
!.env.example
data/
frontend/
notebooks/
tests/
scripts/diagnostics/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.md
!README.md
docker-compose.yml
